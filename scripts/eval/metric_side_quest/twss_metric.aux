\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces TWSS on the hand-layup recording, vanilla vs.\ tuned configuration. Both columns use the exponential wait penalty; the linear flavour described in earlier drafts has been removed (see Section\nobreakspace  {}\ref  {sec:qwait}). ``task'' = $\DOTSB \sum@ \slimits@ (L_i/Z)^\gamma / \DOTSB \sum@ \slimits@ L_j^\gamma \cdot (L_{\text  {tot}}/Z) \cdot q_i$; ``wait'' = $w_w \cdot (T_{\text  {wait}}/Z) \cdot q_{\text  {wait}}$. Thanks to the normalisation by $Z = L_{\text  {tot}} + w_wT_{\text  {wait}}$, the oracle saturates a score of $1.000$ even in the tuned configuration.\relax }}{6}{table.caption.13}\protected@file@percent }
\newlabel{tab:twss-layup}{{3}{6}{TWSS on the hand-layup recording, vanilla vs.\ tuned configuration. Both columns use the exponential wait penalty; the linear flavour described in earlier drafts has been removed (see Section~\ref {sec:qwait}). ``task'' = $\sum (L_i/Z)^\gamma / \sum L_j^\gamma \cdot (L_{\text {tot}}/Z) \cdot \qi $; ``wait'' = $w_w \cdot (\Twait /Z) \cdot \qwait $. Thanks to the normalisation by $Z = L_{\text {tot}} + w_w\Twait $, the oracle saturates a score of $1.000$ even in the tuned configuration.\relax }{table.caption.13}{}}
