{
  "name": "Hand Layup Robot Skills",
  "description": "Robot skills for hand layup task — object logistics, consolidation, cleaning, and motion primitives via UR5 External Control API",
  "version": "2.0",
  "api_base_url": "http://localhost:5050",
  "skills": [
    {
      "id": "move_resin_to_workplace",
      "name": "Move Resin to Workplace",
      "description": "Pick up the resin bottle from storage and place it on the workplace in front of the human",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "move_resin_from_storage_to_workplace.prog"}},
      "preconditions": {
        "resin_bottle.location": "storage_area",
        "resin_added": false
      },
      "effects": {
        "resin_bottle.location": "workplace"
      },
      "trigger_after_steps": ["idle"],
      "estimated_duration_sec": 15.0,
      "can_interrupt": false
    },
    {
      "id": "return_resin_to_storage",
      "name": "Return Resin to Storage",
      "description": "Pick up the resin bottle from the workplace and return it to the storage area",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "move_resin_from_workplace_to_storage.prog"}},
      "preconditions": {
        "resin_bottle.location": "workplace"
      },
      "effects": {
        "resin_bottle.location": "storage_area"
      },
      "trigger_after_steps": ["consolidate_with_roller"],
      "estimated_duration_sec": 15.0,
      "can_interrupt": false
    },
    {
      "id": "move_hardener_to_workplace",
      "name": "Move Hardener to Workplace",
      "description": "Pick up the hardener bottle from storage and place it on the workplace in front of the human",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "move_hardener_from_storage_to_workplace.prog"}},
      "preconditions": {
        "hardener_bottle.location": "storage_area",
        "hardener_added": false
      },
      "effects": {
        "hardener_bottle.location": "workplace"
      },
      "trigger_after_steps": ["add_resin_to_cup"],
      "estimated_duration_sec": 15.0,
      "can_interrupt": false
    },
    {
      "id": "return_hardener_to_storage",
      "name": "Return Hardener to Storage",
      "description": "Pick up the hardener bottle from the workplace and return it to the storage area",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "move_hardener_from_workplace_to_storage.prog"}},
      "preconditions": {
        "hardener_bottle.location": "workplace"
      },
      "effects": {
        "hardener_bottle.location": "storage_area"
      },
      "trigger_after_steps": ["consolidate_with_roller"],
      "estimated_duration_sec": 15.0,
      "can_interrupt": false
    },
    {
      "id": "consolidate_with_roller_force",
      "name": "Consolidate Layup with Roller (Force Mode)",
      "description": "Pick up the roller from storage, use force-controlled rolling with Z-axis compliance to press and sweep over the workpiece, then return roller to storage",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "use_roller_to_consolidate_in_force_mode.prog"}},
      "preconditions": {
        "roller.location": "storage_area",
        "consolidated": false,
        "layers_resined": 4
      },
      "effects": {
        "roller.location": "storage_area",
        "consolidated": true
      },
      "trigger_after_steps": ["apply_resin_layer_4"],
      "estimated_duration_sec": 35.0,
      "can_interrupt": false
    },
    {
      "id": "clean_table",
      "name": "Clean Table Surface",
      "description": "Wipe the table surface using force-controlled sweeping motions with a cloth held in the gripper",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "table_cleaning.prog"}},
      "preconditions": {},
      "effects": {
        "table.clean": true
      },
      "estimated_duration_sec": 20.0,
      "can_interrupt": false
    },
    {
      "id": "move_to_named_position",
      "name": "Move to Named Position",
      "description": "Move the robot to a predefined named position (Home, Upright, Stowed, neutral, table_surface_center, etc.)",
      "category": "motion",
      "api_call": {"method": "POST", "endpoint": "/api/move/named", "body": {"name": "<position_name>"}},
      "parameters": [
        {
          "name": "position_name",
          "type": "string",
          "required": true,
          "allowed_values": [
            "Home", "Upright", "Stowed", "neutral",
            "table_surface_center", "table_far_corner", "table_near_corner",
            "Bottle_Resin_Storage", "Bottle_Hardener_Storage",
            "Bottle_Resin_Workspace", "Bottle_Hardener_Workspace",
            "Roller_Storage_Pick",
            "TableRightCorner", "TableLeftCorner"
          ]
        }
      ],
      "preconditions": {},
      "effects": {},
      "estimated_duration_sec": 5.0,
      "can_interrupt": true
    },
    {
      "id": "move_relative",
      "name": "Move Relative",
      "description": "Move the robot by a relative offset from its current position or from a named position. Directions: up, down, left, right, forward, back.",
      "category": "motion",
      "api_call": {"method": "POST", "endpoint": "/api/move/relative", "body": {"direction": "<direction>", "distance": "<distance_m>"}},
      "parameters": [
        {
          "name": "direction",
          "type": "string",
          "required": true,
          "allowed_values": ["up", "down", "left", "right", "forward", "back"]
        },
        {
          "name": "distance",
          "type": "number",
          "required": false,
          "default": 0.05,
          "description": "Distance in meters"
        },
        {
          "name": "reference",
          "type": "string",
          "required": false,
          "default": "current",
          "description": "Reference position name to move relative from (default: current position)"
        }
      ],
      "preconditions": {},
      "effects": {},
      "estimated_duration_sec": 3.0,
      "can_interrupt": true
    },
    {
      "id": "gripper_open",
      "name": "Open Gripper",
      "description": "Open the Robotiq gripper to release an object",
      "category": "gripper",
      "api_call": {"method": "POST", "endpoint": "/api/gripper", "body": {"action": "open"}},
      "preconditions": {},
      "effects": {
        "gripper.state": "open"
      },
      "estimated_duration_sec": 1.0,
      "can_interrupt": false
    },
    {
      "id": "gripper_close",
      "name": "Close Gripper",
      "description": "Close the Robotiq gripper to grasp an object",
      "category": "gripper",
      "api_call": {"method": "POST", "endpoint": "/api/gripper", "body": {"action": "close"}},
      "preconditions": {},
      "effects": {
        "gripper.state": "closed"
      },
      "estimated_duration_sec": 1.0,
      "can_interrupt": false
    },
    {
      "id": "set_speed",
      "name": "Set Speed",
      "description": "Set the robot speed factor (0.0 to 1.0)",
      "category": "utility",
      "api_call": {"method": "POST", "endpoint": "/api/speed", "body": {"speed": "<factor>"}},
      "parameters": [
        {
          "name": "factor",
          "type": "number",
          "required": true,
          "description": "Speed factor between 0.0 and 1.0"
        }
      ],
      "preconditions": {},
      "effects": {},
      "estimated_duration_sec": 0.5,
      "can_interrupt": true
    },
    {
      "id": "stop_program",
      "name": "Stop Program",
      "description": "Emergency stop — halt the current program and hold at current position",
      "category": "utility",
      "api_call": {"method": "POST", "endpoint": "/api/program/stop"},
      "preconditions": {},
      "effects": {},
      "estimated_duration_sec": 0.5,
      "can_interrupt": true
    },
    {
      "id": "wait",
      "name": "Wait",
      "description": "Wait for a specified duration or until the human signals readiness",
      "category": "utility",
      "parameters": [
        {"name": "duration_sec", "type": "number", "required": false, "default": 5.0},
        {"name": "condition", "type": "string", "required": false}
      ],
      "preconditions": {},
      "effects": {},
      "estimated_duration_sec": 5.0,
      "can_interrupt": true
    }
  ]
}
