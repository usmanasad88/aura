      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "add_sugar_to_cup.prog"}},
      "preconditions": {
        "cup_1.location": "working_area",
        "sugar_container.location": "working_area",
        "tea_poured": true,
        "sugar_preference_known": true
