{
  "name": "Tea Making Robot Skills",
  "description": "Robot skills for collaborative tea making task — object logistics, sugar dispensing, stirring, and motion primitives via UR5 External Control API",
  "version": "2.1",
  "api_base_url": "http://localhost:5050",
  "skills": [
    {
      "id": "retrieve_pot",
      "name": "Retrieve Pot",
      "description": "Pick up the cooking pot from storage and place it in the working area in front of the human",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "retrieve_pot_from_storage_to_working_area.prog"}},
      "preconditions": {
        "pot.location": "storage_area"
      },
      "effects": {
        "pot.location": "working_area"
      },
      "trigger_steps": ["setup_workspace", "fill_pot_with_water"],
      "estimated_duration_sec": 8.0,
      "can_interrupt": false
    },
    {
      "id": "return_pot",
      "name": "Return Pot",
      "description": "Pick up the pot from the working area and return it to storage",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "return_pot_from_working_area_to_storage.prog"}},
      "preconditions": {
        "pot.location": "working_area",
        "tea_served": true
      },
      "effects": {
        "pot.location": "storage_area"
      },
      "trigger_after_steps": ["cleanup"],
      "estimated_duration_sec": 6.0,
      "can_interrupt": false
    },
    {
