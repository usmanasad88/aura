{
  "name": "Tea Making Robot Skills",
  "description": "Robot skills for collaborative tea making task",
  "version": "2.0",
  "skills": [
    {
      "id": "retrieve_object",
      "name": "Retrieve Object",
      "description": "Pick up an object from storage area and place it in the working area in front of the human",
      "category": "program",
      "parameters": [
        {"name": "object_id", "type": "object_id", "description": "ID of the object to retrieve", "required": true}
      ],
      "preconditions": {
        "object.at_region": "storage_area"
      },
      "estimated_duration_sec": 8.0,
      "can_interrupt": true
    },
    {
      "id": "return_object",
      "name": "Return Object",
      "description": "Return an object from working area back to storage",
      "category": "program",
      "parameters": [
        {"name": "object_id", "type": "object_id", "description": "ID of the object to return", "required": true}
      ],
      "preconditions": {
        "object.at_region": "working_area",
        "task.tea_served": true
      },
      "estimated_duration_sec": 6.0,
      "can_interrupt": true
    },
    {
      "id": "add_sugar",
      "name": "Add Sugar",
      "description": "Add sugar to a cup based on user preference",
      "category": "program",
      "parameters": [
        {"name": "target_id", "type": "object_id", "description": "Cup to add sugar to", "required": true},
        {"name": "amount", "type": "string", "description": "Amount of sugar", "required": false, "default": "standard"}
      ],
      "preconditions": {
        "target.at_region": "working_area",
        "task.tea_poured": true,
        "task.sugar_preference_known": true,
        "sugar_container.at_region": "working_area"
      },
      "estimated_duration_sec": 5.0,
      "can_interrupt": false
    },
    {
      "id": "stir",
      "name": "Stir Contents",
      "description": "Stir the contents of a cup using a spoon",
      "category": "program",
      "parameters": [
        {"name": "target_id", "type": "object_id", "description": "Cup to stir", "required": true}
      ],
      "preconditions": {
        "target.at_region": "working_area",
        "spoon.at_region": "working_area"
      },
      "estimated_duration_sec": 5.0,
      "can_interrupt": true
    },
    {
      "id": "ask_preference",
      "name": "Ask Sugar Preference",
      "description": "Ask the human about their sugar preference via speech",
      "category": "utility",
      "preconditions": {
        "task.tea_poured": true,
        "task.sugar_preference_known": false
      },
      "estimated_duration_sec": 10.0,
      "can_interrupt": true
    },
    {
      "id": "stop_program",
      "name": "Stop Program",
      "description": "Emergency stop — halt current program",
      "category": "utility",
      "preconditions": {},
      "estimated_duration_sec": 0.5,
      "can_interrupt": true
    },
    {
      "id": "wait",
      "name": "Wait",
      "description": "Wait for a specified duration or until the human signals readiness",
      "category": "utility",
      "parameters": [
        {"name": "duration_sec", "type": "number", "required": false, "default": 5.0},
        {"name": "condition", "type": "string", "required": false}
      ],
      "preconditions": {},
      "estimated_duration_sec": 5.0,
      "can_interrupt": true
    }
  ]
}
