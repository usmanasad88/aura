      "estimated_duration_sec": 5.0,
      "can_interrupt": false
    },
    {
      "id": "stir_cup_contents",
      "name": "Stir Cup Contents",
      "description": "Stir the contents of the cup using the spoon held in the gripper",
      "category": "program",
      "api_call": {"method": "POST", "endpoint": "/api/program/execute", "body": {"program": "stir_cup_contents.prog"}},
      "preconditions": {
        "cup_1.location": "working_area",
        "spoon.location": "working_area",
        "sugar_added": true
      },
      "effects": {},
      "trigger_steps": ["stir_cup"],
      "estimated_duration_sec": 5.0,
      "can_interrupt": false
    },
    {
      "id": "ask_sugar_preference",
      "name": "Ask Sugar Preference",
      "description": "Ask the human about their sugar preference via spoken prompt",
      "category": "utility",
      "api_call": {"method": "POST", "endpoint": "/api/speak", "body": {"text": "Would you like sugar in your tea?"}},
      "preconditions": {
        "tea_poured": true,
        "sugar_preference_known": false
      },
      "effects": {
        "sugar_preference_known": true
      },
      "trigger_steps": ["ask_sugar_preference"],
      "estimated_duration_sec": 10.0,
      "can_interrupt": true
    },
    {
      "id": "move_to_named_position",
      "name": "Move to Named Position",
      "description": "Move the robot to a predefined named position (Home, Upright, Stowed, neutral, etc.)",
      "category": "motion",
      "api_call": {"method": "POST", "endpoint": "/api/move/named", "body": {"name": "<position_name>"}},
      "parameters": [
        {
          "name": "position_name",
          "type": "string",
          "required": true,
          "allowed_values": [
            "Home", "Upright", "Stowed", "neutral",
            "Pot_Storage", "Cup_1_Storage", "Cup_2_Storage",
            "Tea_Container_Storage", "Milk_Container_Storage",
            "Sugar_Container_Storage", "Spoon_Storage",
            "Working_Area_Center"
          ]
        }
      ],
      "preconditions": {},
      "effects": {},
      "estimated_duration_sec": 5.0,
      "can_interrupt": true
    },
