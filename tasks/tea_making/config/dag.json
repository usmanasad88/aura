[
  {"id": "idle", "description": "System initialized, waiting for task to begin", "dependencies": []},
  {"id": "setup_workspace", "description": "Robot retrieves necessary items to working area", "dependencies": ["idle"]},
  {"id": "fill_pot_with_water", "description": "Human fills pot with water", "dependencies": ["setup_workspace"]},
  {"id": "place_pot_on_stove", "description": "Human places pot on induction cooker", "dependencies": ["fill_pot_with_water"]},
  {"id": "turn_on_stove", "description": "Human turns on induction cooker", "dependencies": ["place_pot_on_stove"]},
  {"id": "wait_for_boil", "description": "Wait for water to boil", "dependencies": ["turn_on_stove"]},
  {"id": "add_chai_powder", "description": "Human adds chai powder to boiling water", "dependencies": ["wait_for_boil"]},
  {"id": "simmer_tea", "description": "Let tea simmer", "dependencies": ["add_chai_powder"]},
  {"id": "add_milk_to_pot", "description": "Add powdered milk to pot", "dependencies": ["simmer_tea"]},
  {"id": "stir_pot", "description": "Stir the tea in pot", "dependencies": ["add_milk_to_pot"]},
  {"id": "pour_tea", "description": "Human pours tea into cups", "dependencies": ["stir_pot"]},
  {"id": "ask_sugar_preference", "description": "Robot asks about sugar preference", "dependencies": ["pour_tea"]},
  {"id": "add_sugar", "description": "Robot adds sugar based on preference", "dependencies": ["ask_sugar_preference"]},
  {"id": "skip_sugar", "description": "Skip sugar (user declined)", "dependencies": ["ask_sugar_preference"]},
  {"id": "stir_cup", "description": "Robot stirs the cup after adding sugar", "dependencies": ["add_sugar"]},
  {"id": "serve_tea", "description": "Tea is ready to serve", "dependencies": ["skip_sugar", "stir_cup"]},
  {"id": "cleanup", "description": "Robot returns unused items to storage", "dependencies": ["serve_tea"]},
  {"id": "task_complete", "description": "Task finished, tea served", "dependencies": ["cleanup"]}
]
