[
  {"id": "idle", "description": "System initialized, waiting for task to begin", "dependencies": []},
  {"id": "setup_workspace", "description": "Retrieves necessary items to working area", "dependencies": ["idle"]},
  {"id": "fill_pot_with_water", "description": "Fills pot with water", "dependencies": ["setup_workspace"]},
  {"id": "place_pot_on_stove", "description": "Places pot on induction cooker", "dependencies": ["setup_workspace"]},
  {"id": "turn_on_stove", "description": "Turns on induction cooker", "dependencies": ["place_pot_on_stove"]},
  {"id": "wait_for_boil", "description": "Wait for water to boil", "dependencies": ["turn_on_stove", "fill_pot_with_water"]},
  {"id": "add_chai_powder", "description": "Adds chai powder to boiling water", "dependencies": ["wait_for_boil"]},
  {"id": "simmer_tea", "description": "Let tea simmer", "dependencies": ["add_chai_powder"]},
  {"id": "add_milk_to_cup", "description": "Add powdered milk to cup", "dependencies": ["setup_workspace"]},
  {"id": "stir_pot", "description": "Stir the tea in pot", "dependencies": ["simmer_tea"]},
  {"id": "pour_tea", "description": "Pours tea into cups", "dependencies": ["stir_pot"]},
  {"id": "ask_sugar_preference", "description": "Asks about sugar preference", "dependencies": ["pour_tea"]},
  {"id": "add_sugar", "description": "Adds sugar based on preference", "dependencies": ["ask_sugar_preference"]},
  {"id": "skip_sugar", "description": "Skip sugar (user declined)", "dependencies": ["ask_sugar_preference"]},
  {"id": "stir_cup", "description": "Stirs the cup after adding sugar", "dependencies": ["add_sugar"]},
  {"id": "cleanup", "description": "Returns unused items to storage", "dependencies": ["skip_sugar", "stir_cup"]},
  {"id": "task_complete", "description": "Task finished, tea served", "dependencies": ["cleanup"]}
]
